# Set-intersection aggregation operator fragment.
# Computes the effective value of a property along the derived_from* chain as the
# set of values that appear in EVERY ancestor that has at least one assertion for
# this property (i.e., every constrained ancestor).
#
# Ancestors that assert nothing for this property are treated as unconstrained
# (don't-care) and are excluded from the count of constrainers.
#
# Substitutions performed at runtime by RdfStoreNode:
#   # PATH #     -> the outer attribute property IRI, e.g. property:transportation_mode
#   # OUT_VAR #  -> the local-part name used as the output binding, e.g. transportation_mode
#
# Sections delimited by paired identical markers (extracted via __regexMatchPlaceholders):
# SELECT_FRAGMENT, GROUP_BY_FRAGMENT, WHERE_FRAGMENT.
#
# Note: intersection contributes nothing to GROUP BY because GROUP_CONCAT is itself
# an aggregate. The raw per-row name binding (?<OUT_VAR>_name) lives inside WHERE
# and is consumed by the GROUP_CONCAT in SELECT.

# SELECT_FRAGMENT ##############
(GROUP_CONCAT(DISTINCT ?# OUT_VAR #_name; separator=", ") AS ?# OUT_VAR #)
# SELECT_FRAGMENT ##############

# GROUP_BY_FRAGMENT ############
# GROUP_BY_FRAGMENT ############

# WHERE_FRAGMENT ###############
OPTIONAL {
	{
		SELECT ?target (COUNT(DISTINCT ?constrainedAnc_# OUT_VAR #) AS ?totalConstrained_# OUT_VAR #)
		WHERE {
			?target property:derived_from* ?constrainedAnc_# OUT_VAR # .
			?constrainedAnc_# OUT_VAR # # PATH #/property:discrete_value ?anyVal_# OUT_VAR # .
		}
		GROUP BY ?target
	}
	{
		SELECT ?target ?val_# OUT_VAR # (COUNT(DISTINCT ?anc_# OUT_VAR #) AS ?modeCount_# OUT_VAR #)
		WHERE {
			?target property:derived_from* ?anc_# OUT_VAR # .
			?anc_# OUT_VAR # # PATH #/property:discrete_value ?val_# OUT_VAR # .
		}
		GROUP BY ?target ?val_# OUT_VAR #
	}
	?val_# OUT_VAR # property:name ?# OUT_VAR #_name .
	FILTER (?modeCount_# OUT_VAR # >= ?totalConstrained_# OUT_VAR #)
}
# WHERE_FRAGMENT ###############
