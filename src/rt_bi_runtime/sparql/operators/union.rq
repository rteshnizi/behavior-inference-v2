# Set-union aggregation operator fragment.
# Computes the effective value of a property along the derived_from* chain as the
# set of all asserted values, projected as a comma-separated string of property:name
# values via GROUP_CONCAT(DISTINCT ...).
#
# Substitutions performed at runtime by RdfStoreNode:
#   # PROP_URI #  -> the full property IRI, e.g. property:transportation_mode
#   # OUT_VAR #   -> the local-part name used as the output binding, e.g. transportation_mode
#
# Sections delimited by paired identical markers (extracted via __regexMatchPlaceholders):
# SELECT_FRAGMENT, GROUP_BY_FRAGMENT, WHERE_FRAGMENT.
#
# Note: union contributes nothing to GROUP BY because GROUP_CONCAT is itself an
# aggregate. The raw per-row name binding (?<OUT_VAR>_name) lives inside WHERE and
# is consumed by the GROUP_CONCAT in SELECT.

# SELECT_FRAGMENT ##############
(GROUP_CONCAT(DISTINCT ?# OUT_VAR #_name; separator=", ") AS ?# OUT_VAR #)
# SELECT_FRAGMENT ##############

# GROUP_BY_FRAGMENT ############
# GROUP_BY_FRAGMENT ############

# WHERE_FRAGMENT ###############
OPTIONAL {
	?target property:derived_from* ?anc_# OUT_VAR # .
	?anc_# OUT_VAR # # PROP_URI # ?val_# OUT_VAR # .
	?val_# OUT_VAR # property:name ?# OUT_VAR #_name .
}
# WHERE_FRAGMENT ###############
