# Min-rank aggregation operator fragment.
# Computes the effective value of a ranked property along the derived_from* chain
# as the value with the smallest property:rank (i.e., the most-constrained / tightest bound).
#
# Substitutions performed at runtime by RdfStoreNode:
#   # PROP_URI #  -> the full property IRI, e.g. property:diameter_bound
#   # OUT_VAR #   -> the local-part name used as the output binding, e.g. diameter_bound
#
# The fragment exposes three labeled sections, each delimited by identical markers
# on both sides (extracted via __regexMatchPlaceholders): SELECT_FRAGMENT,
# GROUP_BY_FRAGMENT, WHERE_FRAGMENT. The Python layer extracts each, performs
# substitution, and inserts into the matching placeholder of targets.rq.

# SELECT_FRAGMENT ##############
?# OUT_VAR #
# SELECT_FRAGMENT ##############

# GROUP_BY_FRAGMENT ############
?# OUT_VAR #
# GROUP_BY_FRAGMENT ############

# WHERE_FRAGMENT ###############
OPTIONAL {
	{
		SELECT ?target (MIN(?rank_# OUT_VAR #) AS ?minRank_# OUT_VAR #)
		WHERE {
			?target property:derived_from* ?anc_# OUT_VAR # .
			?anc_# OUT_VAR # # PROP_URI # ?val_# OUT_VAR # .
			?val_# OUT_VAR # property:rank ?rank_# OUT_VAR # .
		}
		GROUP BY ?target
	}
	?target property:derived_from* ?anc2_# OUT_VAR # .
	?anc2_# OUT_VAR # # PROP_URI # ?eff_# OUT_VAR # .
	?eff_# OUT_VAR # property:rank ?minRank_# OUT_VAR # ;
					property:name ?# OUT_VAR # .
}
# WHERE_FRAGMENT ###############
