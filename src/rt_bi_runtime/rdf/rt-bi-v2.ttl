@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://rezateshnizi.com/rt-bi-v2/> a owl:Ontology ;
	dc:title "The vocabulary used in RT Behavior Inference version 2." ;
	dc:date "2025-10-22" ;
	dc:description "This is the RDF Schema for the terms in RT Behavior Automata." .

@prefix class: <https://rezateshnizi.com/rt-bi-v2/class#> .
@prefix property: <https://rezateshnizi.com/rt-bi-v2/property#> .
@prefix aggregation: <https://rezateshnizi.com/env/aggregations#> .

# region [CLASSES]
class:Coordinate a rdfs:Class .
class:X a rdfs:Class ; rdfs:subClassOf class:Coordinate .
class:Y a rdfs:Class ; rdfs:subClassOf class:Coordinate .
class:Pt a rdfs:Class ;
	rdfs:comment "Has an X and a Y" .
class:PtSeq a rdfs:Class ;
	rdfs:subClassOf rdf:Seq ;
	rdfs:comment "A sequence, to indicate to a human reader that the members are ordered points." .
class:Polygon a rdfs:Class .
class:Subject a rdfs:Class .
class:Time a rdfs:Class ;
	rdfs:subClassOf class:Subject .
class:Interval a rdfs:Class ;
	rdfs:subClassOf class:Subject .
class:SpaceTime a rdfs:Class ;
	rdfs:subClassOf class:Subject ;
	rdfs:comment "The class of Regular Space-Time Set specifications." .
class:Target a rdfs:Class ;
	rdfs:subClassOf class:Subject ;
	rdfs:comment "The class of target specifications. This is used to specify target attributes." .
class:Material a rdfs:Class ;
	rdfs:subClassOf class:Subject ;
	rdfs:comment "The class of material specifications." .
class:Transportation a rdfs:Class ;
	rdfs:subClassOf class:Subject ;
	rdfs:comment "The way this target moves; i.e., mode of transportation." .
# SPACE-TIME SPEC
class:TraversabilityRestriction a rdfs:Class ;
	rdfs:comment "The class of traversal constraint specifications." .
class:TargetCategory a rdfs:Class ;
	rdfs:comment "The class of target categories specifying general information about the target." .
# AGGREGATION RULES
class:AggregationOperator a rdfs:Class ;
	rdfs:comment "An operator that determines how a property's values are combined over a derived_from* chain." .
class:Attribute a rdfs:Class ;
	rdfs:comment "Abstract base for attribute value wrappers." .
class:DiscreteAttribute a rdfs:Class ;
	rdfs:subClassOf class:Attribute ;
	rdfs:comment "An attribute whose value belongs to a discrete set." .
class:RangedAttribute a rdfs:Class ;
	rdfs:subClassOf class:Attribute ;
	rdfs:comment "An attribute whose value is a real interval [range_min, range_max]." .
# endregion [CLASSES]

# endregion [SPACE-TIME PROPS]
property:material a rdf:Property ;
	rdfs:domain class:SpaceTime ;
	rdfs:range class:Material ;
	rdfs:comment "The physical material of a space-time set." .
# endregion [SPACE-TIME PROPS]

# region [AGGREGATION RULES]
property:aggregation_operator a rdf:Property ;
	rdfs:domain rdf:Property ;
	rdfs:range class:AggregationOperator .
aggregation:intersection a class:AggregationOperator ;
	rdfs:label "intersection" .
aggregation:range_min a class:AggregationOperator ;
	rdfs:label "range-min" .
aggregation:range_max a class:AggregationOperator ;
	rdfs:label "range-max" .
# endregion [AGGREGATION RULES]

# region [ATTRIBUTE REIFICATION]
# Units: diameter and height are in meters; age is in years.
property:discrete_value a rdf:Property ;
	rdfs:domain class:DiscreteAttribute ;
	rdfs:range rdfs:Resource ;
	property:aggregation_operator aggregation:intersection ;
	rdfs:comment "The asserted discrete value(s) of this attribute." .
property:range_min a rdf:Property ;
	rdfs:domain class:RangedAttribute ;
	rdfs:range xsd:decimal ;
	property:aggregation_operator aggregation:range_min .
property:range_max a rdf:Property ;
	rdfs:domain class:RangedAttribute ;
	rdfs:range xsd:decimal ;
	property:aggregation_operator aggregation:range_max .
# endregion [ATTRIBUTE REIFICATION]

# region [SUBJECT PROPS]
property:name a rdf:Property ;
	rdfs:subPropertyOf rdfs:label ;
	rdfs:domain class:Subject ;
	rdfs:range xsd:string ;
	rdfs:comment "A name for this subject." .
property:color a rdf:Property ;
	rdfs:domain class:Subject ;
	rdfs:range xsd:string ;
	rdfs:comment "Color to describe this area (and use in render)." .
# endregion [SUBJECT PROPS]

# region [SPATIAL PROPS]
property:vertices a rdf:Property ;
	rdfs:domain class:Polygon ;
	rdfs:range class:PtSeq ;
	rdfs:comment "The vertices of a polygon." .
property:coord a rdf:Property ;
	rdfs:domain class:Pt ;
	rdfs:range class:Coordinate ;
	rdfs:comment "A real axis coordinate (x, y, etc.)." .
property:x_val a rdf:Property ;
	rdfs:subPropertyOf rdf:value ;
	rdfs:domain class:X ;
	rdfs:range xsd:double ;
	rdfs:comment "Some x value." .
property:y_val a rdf:Property ;
	rdfs:subPropertyOf rdf:value ;
	rdfs:domain class:Y ;
	rdfs:range xsd:double ;
	rdfs:comment "Some y value." .
property:geometry a rdf:Property ;
	rdfs:domain class:SpaceTime ;
	rdfs:range class:Polygon ;
	rdfs:comment "The range of this property describes the geometry of a connected component." .
property:traversability_restriction a rdf:Property ;
	rdfs:domain class:SpaceTime ;
	rdfs:range class:TraversabilityRestriction ;
	rdfs:comment "Points to constraints that must be satisfied for a target to traverse this space" .
# endregion [SPATIAL PROPS]

# region [TEMPORAL PROPS]
property:t_val a rdf:Property ;
	rdfs:subPropertyOf rdf:value ;
	rdfs:domain class:Time ;
	rdfs:range xsd:double ;
	rdfs:comment "A time value in Seconds." .
property:min a rdf:Property ;
	rdfs:domain class:Interval ;
	rdfs:range class:Time ;
	rdfs:comment "The min bound of a time interval." .
property:max a rdf:Property ;
	rdfs:domain class:Interval ;
	rdfs:range class:Time ;
	rdfs:comment "The max bound of a time interval." .
property:include_min a rdf:Property ;
	rdfs:domain class:Interval ;
	rdfs:range xsd:boolean ;
	rdfs:comment "Whether the min bound is included in the interval" .
property:include_max a rdf:Property ;
	rdfs:domain class:Interval ;
	rdfs:range xsd:boolean ;
	rdfs:comment "Whether the max bound is included in the interval" .
property:interval a rdf:Property ;
	rdfs:domain class:SpaceTime ;
	rdfs:range class:Interval .
# endregion [TEMPORAL PROPS]

# region [SPACE-TIME PROPS]
property:channel a rdf:Property ;
	rdfs:domain class:SpaceTime ;
	rdfs:range xsd:string ;
	rdfs:comment "The ID of the ROS communication channel publishing updates for this SpaceTime." .
# endregion [SPACE-TIME PROPS]

# region [TARGET PROPS]
property:derived_from a rdf:Property ;
	rdfs:domain class:Target ;
	rdfs:range class:Target ;
	rdfs:comment "Refinement relation between hypotheses: child is a more specific hypothesis." .
property:target_category a rdf:Property ;
	rdfs:domain class:Target ;
	rdfs:range class:TargetCategory ;
	rdfs:comment "The target's category" .
property:transportation_mode a rdf:Property ;
	rdfs:domain class:Subject ;
	rdfs:range class:DiscreteAttribute ;
	rdfs:comment "Mode of transportation; values are reified as DiscreteAttribute blank nodes." .
property:diameter a rdf:Property ;
	rdfs:domain class:Subject ;
	rdfs:range class:RangedAttribute ;
	rdfs:comment "Diameter/width in meters; values are reified as RangedAttribute blank nodes." .
property:height a rdf:Property ;
	rdfs:domain class:Subject ;
	rdfs:range class:RangedAttribute ;
	rdfs:comment "Height in meters; values are reified as RangedAttribute blank nodes." .
property:age a rdf:Property ;
	rdfs:domain class:Subject ;
	rdfs:range class:RangedAttribute ;
	rdfs:comment "Age in years; values are reified as RangedAttribute blank nodes." .
# endregion [TARGET PROPS]
