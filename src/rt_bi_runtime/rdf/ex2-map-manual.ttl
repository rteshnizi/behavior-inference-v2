	property:name "WW3" ;
	property:geometry polygon:wall_w_3 ;
	property:material material:obstacle .

set:wbn a class:SpaceTime ;
	property:name "WBN" ;
	property:geometry polygon:wall_b_n ;
	property:material material:obstacle .

