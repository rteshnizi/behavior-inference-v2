set:wbw2 a class:SpaceTime ;
	property:name "WBW2" ;
	property:geometry polygon:wall_b_w_2 ;
	property:material material:obstacle .

set:bridge a class:SpaceTime ;
	property:name "Bridge" ;
	property:geometry polygon:bridge ;
	property:material material:wood ;
	property:traversability_req traversability:bridge .

set:door_1 a class:SpaceTime ;
	property:name "Door 1" ;
	property:geometry polygon:door_1 ;
	property:material material:metal ;
	property:traversability_req traversability:door .

set:door_b a class:SpaceTime ;
	property:name "Door B" ;
	property:geometry polygon:door_b ;
	property:material material:metal ;
	property:traversability_req traversability:door .

set:a_1 a class:SpaceTime ;
	property:name "Asphalt 1" ;
	property:geometry polygon:asphalt_1 ;
	property:material material:asphalt ;
	property:traversability_req traversability:unrestricted .

set:a_2 a class:SpaceTime ;
	property:name "Asphalt 2" ;
	property:geometry polygon:asphalt_2 ;
	property:material material:asphalt ;
	property:traversability_req traversability:unrestricted .

set:a_3 a class:SpaceTime ;
	property:name "Asphalt 3" ;
