# region Space-Time Material Definitions
material:obstacle a class:Material ; property:name "obstacle" ; property:color "BLACK" .
material:water a class:Material ; property:name "water" ; property:color "BLUE_LIGHT" .
material:carpet a class:Material ; property:name "carpet" ; property:color "PURPLE" .
material:wood a class:Material ; property:name "wood" ; property:color "BROWN" .
material:tile a class:Material ; property:name "tile" ; property:color "WHITE" .
material:cement a class:Material ; property:name "cement" ; property:color "GREY_LIGHT" .
material:asphalt a class:Material ; property:name "asphalt" ; property:color "GREY" .
material:grass a class:Material ; property:name "grass" ; property:color "GREEN" .
material:bush a class:Material ; property:name "bush" ; property:color "GREEN_DARK" .
material:metal a class:Material ; property:name "metal" ; property:color "ORANGE" .
# endregion Space-Time Material Definitions

# region Target Property Definitions
transportation:walking a class:Transportation ; property:name "walking" .
transportation:swimming a class:Transportation ; property:name "swimming" .
transportation:vehicle a class:Transportation ; property:name "vehicle" .
transportation:bicycle a class:Transportation ; property:name "bicycle" .
diameter:narrow a class:Diameter ; property:name "narrow" ; property:rank 1 .
diameter:medium a class:Diameter ; property:name "medium" ; property:rank 2 .
diameter:wide a class:Diameter ; property:name "wide" ; property:rank 3 .
height:short a class:Height ; property:name "short" ; property:rank 1 .
height:medium a class:Height ; property:name "medium" ; property:rank 2 .
height:tall a class:Height ; property:name "tall" ; property:rank 3 .
# endregion Target Property Definitions

# region Traversability Requirements
traversability:door a class:TraversabilityReq ;
	property:transportation_req transportation:walking ;
	property:max_diameter diameter:narrow ;
	property:max_height height:medium .
traversability:river a class:TraversabilityReq ;
	property:transportation_req transportation:swimming .
traversability:room a class:TraversabilityReq ;
	property:transportation_req transportation:walking .
traversability:bridge a class:TraversabilityReq ;
	property:transportation_req transportation:walking ;
	property:transportation_req transportation:vehicle ;
	property:transportation_req transportation:bicycle ;
	property:max_diameter diameter:medium .
traversability:under_bridge a class:TraversabilityReq ;
	property:transportation_req transportation:swimming ;
	property:max_diameter diameter:narrow ;
	property:max_height height:short .
traversability:unrestricted a class:TraversabilityReq ;
	property:transportation_req transportation:walking ;
	property:transportation_req transportation:swimming ;
	property:transportation_req transportation:vehicle ;
	property:transportation_req transportation:bicycle .
# endregion Traversability Requirements

# region Space-Time Sets
set:a a class:SpaceTime ;
	property:name "A" ;
	property:geometry polygon:a ;
	property:material material:cement ;
	property:traversability_req traversability:room .

set:b a class:SpaceTime ;
	property:name "B" ;
	property:geometry polygon:b ;
	property:material material:cement ;
	property:traversability_req traversability:room .

set:c a class:SpaceTime ;
	property:name "C" ;
	property:geometry polygon:c ;
	property:material material:cement ;
	property:traversability_req traversability:room .

set:r1 a class:SpaceTime ;
	property:name "R1" ;
	property:geometry polygon:river_1 ;
	property:material material:water ;
	property:traversability_req traversability:river .

set:r2 a class:SpaceTime ;
	property:name "R2" ;
	property:geometry polygon:river_2 ;
	property:material material:water ;
	property:traversability_req traversability:river .

set:r3 a class:SpaceTime ;
	property:name "R3" ;
	property:geometry polygon:river_3 ;
	property:material material:water ;
	property:traversability_req traversability:river .

