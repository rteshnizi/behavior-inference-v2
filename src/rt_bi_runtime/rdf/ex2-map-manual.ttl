	property:traversability_req traversability:unrestricted .

set:a_6 a class:SpaceTime ;
	property:name "Asphalt 6" ;
	property:geometry polygon:asphalt_6 ;
	property:material material:asphalt ;
	property:traversability_req traversability:unrestricted .

set:a_7 a class:SpaceTime ;
	property:name "Asphalt 7" ;
	property:geometry polygon:asphalt_7 ;
	property:material material:asphalt ;
	property:traversability_req traversability:unrestricted .
# endregion Space-Time Sets

# region Targets
target:t1 a class:Target ;
	property:name "Target 1" .

target:t2 a class:Target ;
	property:derived_from target:t1 ;
	property:diameter_bound diameter:medium ;
	property:transportation_mode transportation:walking .

target:t3 a class:Target ;
	property:derived_from target:t2 ;
	property:diameter_bound diameter:narrow ;
	property:transportation_mode transportation:vehicle .

target:t4 a class:Target ;
	property:derived_from target:t2 ;
	property:diameter_bound diameter:wide .
# endregion Targets
